            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "slotmachine",
        "slot machine",
        "slots",
        "casino simulator",
        "gambling",
        "random slots"
    ],
    "homepage": "https://apiverve.com/marketplace/slotmachine?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/slotmachine",
        "source": "https://github.com/apiverve/slotmachine-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Slotmachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Slotmachine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
